            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AI-145 Signal {{$timestamp}}\",\n  \"description\": \"Signal library created from the AI-145 Postman collection.\",\n  \"engineeringUnit\": \"V\",\n  \"interfaceEntity\": {\n    \"id\": {{interfaceId}}\n  },\n  \"lru\": {\n    \"id\": {{lruId}}\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/signal-libraries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "signal-libraries"
