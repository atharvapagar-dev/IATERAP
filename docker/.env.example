# Copy this file to docker/.env and replace every placeholder before running
# docker compose. docker/.env is ignored and must never be committed.
POSTGRES_DB=iaterap
POSTGRES_USER=iaterap_app
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_PORT=5432
APP_PORT=80

# Use at least 32 random bytes. A base64 value is supported by the backend.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Optional: defaults to the private Compose AI service address.
AI_ADVISORY_BASE_URL=http://ai-service:8000
