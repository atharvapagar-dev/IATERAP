        {
          "name": "Create Signal Library",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates signal library', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.id).to.exist;",
                  "  pm.collectionVariables.set('signalLibraryId', response.id);",
