{
  "info": {
    "name": "IATERAP Procedure Authoring and Submit Regression",
    "description": "AI-190 / T8-A3 regression collection for the authenticated author -> save -> submit-for-review flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "admin123" },
    { "key": "accessToken", "value": "" },
    { "key": "lruId", "value": "" },
    { "key": "interfaceId", "value": "" },
    { "key": "connectorId", "value": "" },
    { "key": "signalLibraryId", "value": "" },
    { "key": "protocolTagId", "value": "" },
    { "key": "faultCategoryId", "value": "" },
    { "key": "procedureId", "value": "" },
    { "key": "createdVersion", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
        "pm.collectionVariables.set('accessToken', body.accessToken);"
      ] } }]
    },
    {
      "name": "2. Resolve seeded references",
      "item": [
        {
          "name": "Get LRU",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/lrus" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('lruId', rows[0].id);"
          ] } }]
        },
        {
          "name": "Get Interface",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/interfaces/by-lru/{{lruId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('interfaceId', rows[0].id);"
          ] } }]
        },
        {
          "name": "Get Connector",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/connectors/by-lru/{{lruId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('connectorId', rows[0].id);"
          ] } }]
        },
        {
          "name": "Get Signal Library",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/signal-libraries/by-lru/{{lruId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('signalLibraryId', rows[0].id);"
          ] } }]
        },
        {
          "name": "Get Protocol Tag",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/protocol-tags/by-lru/{{lruId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('protocolTagId', rows[0].id);"
          ] } }]
        },
        {
          "name": "Get Fault Template",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/fault-templates/by-lru/{{lruId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200); const rows = pm.response.json(); pm.expect(rows).to.be.an('array').and.not.empty; pm.collectionVariables.set('faultCategoryId', rows[0].id);"
          ] } }]
        }
      ]
    },
    {
      "name": "3. Create valid DRAFT procedure",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"lruId\": {{lruId}},\n  \"name\": \"AI-190 Submit Regression {{$timestamp}}\",\n  \"description\": \"Full author-to-submit regression procedure\",\n  \"steps\": [{\n    \"interfaceId\": {{interfaceId}},\n    \"connectorId\": {{connectorId}},\n    \"signalLibraryId\": {{signalLibraryId}},\n    \"protocolTagId\": {{protocolTagId}},\n    \"faultCategoryId\": {{faultCategoryId}},\n    \"expectedBehaviour\": \"Signal is present at the selected interface\",\n    \"acceptanceCriteria\": \"Signal remains within the nominal range\",\n    \"executionOrder\": 1,\n    \"passFailCriteria\": \"Pass when the measured signal is nominal; otherwise fail\"\n  }]\n}" },
        "url": "{{baseUrl}}/procedures"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Procedure is created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
        "const body = pm.response.json(); pm.expect(body.approvalStatus).to.eql('DRAFT'); pm.expect(body.steps).to.have.lengthOf(1);",
        "pm.collectionVariables.set('procedureId', body.id); pm.collectionVariables.set('createdVersion', body.versionNumber);"
      ] } }]
    },
    {
      "name": "4. Submit procedure for review",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/procedures/{{procedureId}}/submit-for-review" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Submission succeeds', () => pm.response.to.have.status(200));",
        "const body = pm.response.json(); pm.expect(body.approvalStatus).to.eql('IN_REVIEW'); pm.expect(body.versionNumber).to.eql(Number(pm.collectionVariables.get('createdVersion')) + 1);"
      ] } }]
    },
    {
      "name": "5. Repeat submission returns 409",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/procedures/{{procedureId}}/submit-for-review" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Repeat submission returns conflict', () => pm.response.to.have.status(409));",
        "pm.expect(pm.response.json().message).to.include('IN_REVIEW');"
      ] } }]
    },
    {
      "name": "6. Missing procedure returns 404",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/procedures/999999999/submit-for-review" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Missing procedure returns not found', () => pm.response.to.have.status(404));",
        "pm.expect(pm.response.json().message).to.include('Test procedure not found');"
      ] } }]
    }
  ]
}
