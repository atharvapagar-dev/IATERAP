# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local runtime configuration and secrets. Commit only the corresponding
# *.example templates with non-sensitive placeholders.
.env
.env.*
!.env.example
docker/.env
backend/.env
ai-service/.env

# Locally generated database backup/restore verification artifacts.
backup/
*.dump

# Local clean-checkout Compose verification evidence.
artifacts/clean-compose-verification/

# Local deployment regression evidence.
artifacts/deployment-regression/
