# Local backend environment. Copy to backend/.env for your shell/tooling;
# backend/.env is ignored. Do not use these placeholders as real credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/iaterap
SPRING_DATASOURCE_USERNAME=iaterap_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-unique-local-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=7
AI_ADVISORY_BASE_URL=http://127.0.0.1:8000
